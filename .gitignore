# 以点开头的目录默认忽略（.cache/、.tmp/、.turbo/ 等），下面按需放行
.*/

# 本地开发辅助脚本（不含密钥，纳入版本管理）
!.dev/
!.dev/env.ps1

# 环境变量文件：真实配置含数据库、Redis、JWT 密钥，禁止提交；仓库只保留 .env.example
backend/.env
frontend/apps/*/.env.local
frontend/apps/*/.env.*.local

# 后端构建产物与测试报告
backend/bin/
backend/coverage.out
backend/*.test

# 前端依赖与构建产物
frontend/node_modules/
frontend/apps/*/node_modules/
frontend/apps/*/dist/
frontend/apps/*/dist.zip
frontend/apps/*/stats.html
frontend/packages/**/dist/
frontend/internal/**/dist/
*.tsbuildinfo

# 日志
*.log
