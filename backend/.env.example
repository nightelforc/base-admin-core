# ---------------------------------------------------------------------------
# 环境变量覆盖示例
#
# 全量配置及默认值在 backend/config.yaml。本文件只演示“需要按环境覆盖”的项，
# 不需要把 config.yaml 的所有键再抄一遍。加载顺序：
#   config.yaml < 环境变量
#
# 使用方式：复制为 backend/.env（不要提交），或由 ConfigMap / Secret 注入。
# 配置文件路径可用 CONFIG_FILE 指定；未设置时依次查找 ./config.yaml、
# ./backend/config.yaml。
# ---------------------------------------------------------------------------

# 可选：显式指定配置文件位置（容器里常用绝对路径）。
# CONFIG_FILE=/etc/base-admin/config.yaml

# ---------------------------------------------------------------------------
# 敏感项：也可以只给文件路径（X_FILE），由程序读取挂载进来的文件内容
# ---------------------------------------------------------------------------
# 适用于 Docker Secret / K8s Secret 卷挂载 / Vault Agent：环境变量里只有路径，
# 明文密码不会出现在进程环境里。支持 JWT_SECRET、DB_PASSWORD、REDIS_PASSWORD、
# REDIS_SENTINEL_PASSWORD、BOOTSTRAP_ADMIN_PASSWORD 五项，与直接设置 X 二选一。
# 启用 *_FILE 前，先把下面同名的 X=... 那行注释掉，二者不能同时提供。
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# DB_PASSWORD_FILE=/run/secrets/db_password

# ---------------------------------------------------------------------------
# 运行环境
# ---------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=debug
LOG_FORMAT=text

# ---------------------------------------------------------------------------
# 监控
# ---------------------------------------------------------------------------
# 关闭后不注册任何检查、不创建监控协程；关闭时启动日志会留一条记录。
MONITOR_ENABLED=true

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
HTTP_ADDR=:8080
# 注入到请求 context 的截止时间（预算），0 表示不注入。到点后下游数据库/Redis
# 调用随 context 取消而中断，处理器返回 504 / 50400；响应不会被缓冲或改写。
HTTP_REQUEST_TIMEOUT=30s
# 连接级写截止时间。服务 SSE / WebSocket 时必须为 0（否则到点直接掐断长连接）；
# 不提供长连接时可以设为 60s，避免慢客户端长期占用 goroutine。
HTTP_WRITE_TIMEOUT=0s

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_NAME=base_admin
# L3：由 Secret 注入（或 DB_PASSWORD_FILE 指向文件），不要写进版本库。
DB_PASSWORD=change-me
# 多个部署共用一个 schema 时必须保持唯一。
DB_TABLE_PREFIX=base_
# TCP 建连上限：网络黑洞时靠它快速失败，避免新连接挂到请求超时并占满池槽位。
# 必须是整秒且短于 HTTP_REQUEST_TIMEOUT；0 表示不设置。
DB_CONNECT_TIMEOUT=5s
# 启动时那次连通性验证的预算，必须不短于 DB_CONNECT_TIMEOUT；0 表示使用默认的 10s。
# 数据库故障转移期间可以调大它，让启动等待覆盖更长的不可用窗口。
DB_PING_TIMEOUT=10s
# 单条 SQL 的执行上限（数据库侧止损）。请求超时只能让调用方先放弃，语句仍在跑；
# 这个参数才会真正终止它。必须短于 HTTP_REQUEST_TIMEOUT；0 表示不设置。
# 迁移不受此限制（DDL 可能合法地跑更久）。
DB_STATEMENT_TIMEOUT=5s

# 迁移与首个管理员由 cmd/migrate（集群 Job）执行，server 启动时不再迁移。
# 单进程连接池上限。多副本时总量 = 副本数 × max_open_conns，
# 规划公式见 docs/backend/config.md「连接池容量与多副本」。
# DB_MAX_OPEN_CONNS=15
# DB_MAX_IDLE_CONNS=5

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# standalone（默认）直连数据节点，REDIS_ADDRS 恰好一个地址；
# sentinel 时 REDIS_ADDRS 换成哨兵节点列表，主节点由 REDIS_MASTER_NAME 查出。
# 集群模式未实现。
REDIS_MODE=standalone
REDIS_ADDRS=127.0.0.1:6379
# 仅哨兵模式需要，多个哨兵地址用英文逗号分隔。
# REDIS_MASTER_NAME=mymaster
# REDIS_ADDRS=10.0.0.11:26379,10.0.0.12:26379
# L3：哨兵自身的认证与数据节点认证是两套凭据，按需由 Secret 注入。
# REDIS_SENTINEL_USERNAME=
# REDIS_SENTINEL_PASSWORD=
REDIS_DB=0
# L3：由 Secret 注入（或 REDIS_PASSWORD_FILE）。
REDIS_PASSWORD=
REDIS_KEY_PREFIX=base-admin:
# 取空闲连接的上限（池满时的排队）。它既不是建连时间，也不是命令执行时间，
# 但会被重试次数放大：一次命令最多试 MaxRetries+1 次，每次都要重新排队。
# 必须为正；不配时 go-redis 推导成 read_timeout+1s。
REDIS_POOL_TIMEOUT=1s
# 失败后最多重试几次，0 表示不重试（go-redis 里 0 是"用默认 3 次"、-1 才是关闭，
# 这个约定由代码翻译，配置里填 0 就真的不重试）。
# 最坏耗时 ≈ (REDIS_MAX_RETRIES+1) × (REDIS_POOL_TIMEOUT+REDIS_READ_TIMEOUT)，
# 必须短于 HTTP_REQUEST_TIMEOUT。
REDIS_MAX_RETRIES=1
# 传输加密。托管 Redis 强制 in-transit encryption 时打开；数据节点与哨兵节点
# 共用同一份证书材料。REDIS_TLS_CA_FILE 留空表示信任系统根证书。
REDIS_TLS_ENABLED=false
# REDIS_TLS_CA_FILE=/etc/ssl/certs/redis-ca.pem
# L3：仅服务端要求客户端证书（mTLS）时填写，两个必须成对出现。
# REDIS_TLS_CERT_FILE=/etc/ssl/certs/redis-client.pem
# REDIS_TLS_KEY_FILE=/etc/ssl/private/redis-client.key
# 覆盖证书校验名（连接地址是 IP 而证书签给域名时用）。
# REDIS_TLS_SERVER_NAME=
# L3：仅本地自签环境，关闭服务端证书校验后 TLS 只剩防窃听作用。
# REDIS_TLS_INSECURE_SKIP_VERIFY=false

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# L3：必填，至少 32 个字符；可用 `openssl rand -base64 48` 生成。
# 也可以只给 JWT_SECRET_FILE=/run/secrets/jwt_secret。
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# ---------------------------------------------------------------------------
# CORS（前后端不同源时覆盖）
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false

# ---------------------------------------------------------------------------
# 初始管理员（仅首次启动创建）
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_USERNAME=admin
# 留空则随机生成密码，并在启动日志中打印一次。
BOOTSTRAP_ADMIN_PASSWORD=
