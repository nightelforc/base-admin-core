# ---------------------------------------------------------------------------
# 环境变量覆盖示例
#
# 全量配置及默认值在 backend/config.yaml。本文件只演示“需要按环境覆盖”的项，
# 不需要把 config.yaml 的所有键再抄一遍。加载顺序：
#   内置默认值 < config.yaml < 环境变量
#
# 使用方式：复制为 backend/.env（不要提交），或由 ConfigMap / Secret 注入。
# 配置文件路径可用 CONFIG_FILE 指定；未设置时依次查找 ./config.yaml、
# ./backend/config.yaml。
# ---------------------------------------------------------------------------

# 可选：显式指定配置文件位置（容器里常用绝对路径）。
# CONFIG_FILE=/etc/base-admin/config.yaml

# ---------------------------------------------------------------------------
# 运行环境
# ---------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=debug
LOG_FORMAT=text

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
HTTP_ADDR=:8080
# 注入到请求 context 的截止时间（预算），0 表示不注入。到点后下游数据库/Redis
# 调用随 context 取消而中断，处理器返回 504 / 50400；响应不会被缓冲或改写。
HTTP_REQUEST_TIMEOUT=30s
# 连接级写截止时间。服务 SSE / WebSocket 时必须为 0（否则到点直接掐断长连接）；
# 不提供长连接时可以设为 60s，避免慢客户端长期占用 goroutine。
HTTP_WRITE_TIMEOUT=0s

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_NAME=base_admin
# L3：由 Secret 注入，不要写进版本库。
DB_PASSWORD=change-me
# 多个部署共用一个 schema 时必须保持唯一。
DB_TABLE_PREFIX=base_
# 单条 SQL 的执行上限（数据库侧止损）。请求超时只能让调用方先放弃，语句仍在跑；
# 这个参数才会真正终止它。必须短于 HTTP_REQUEST_TIMEOUT；0 表示不设置。
# 迁移不受此限制（DDL 可能合法地跑更久）。
DB_STATEMENT_TIMEOUT=5s

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# standalone（默认）直连数据节点，REDIS_ADDRS 恰好一个地址；
# sentinel 时 REDIS_ADDRS 换成哨兵节点列表，主节点由 REDIS_MASTER_NAME 查出。
# 集群模式未实现。
REDIS_MODE=standalone
REDIS_ADDRS=127.0.0.1:6379
# 仅哨兵模式需要，多个哨兵地址用英文逗号分隔。
# REDIS_MASTER_NAME=mymaster
# REDIS_ADDRS=10.0.0.11:26379,10.0.0.12:26379
# L3：哨兵自身的认证与数据节点认证是两套凭据，按需由 Secret 注入。
# REDIS_SENTINEL_USERNAME=
# REDIS_SENTINEL_PASSWORD=
REDIS_DB=0
# L3：由 Secret 注入。
REDIS_PASSWORD=
REDIS_KEY_PREFIX=base-admin:

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# L3：必填，至少 32 个字符；可用 `openssl rand -base64 48` 生成。
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# ---------------------------------------------------------------------------
# CORS（前后端不同源时覆盖）
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false

# ---------------------------------------------------------------------------
# 初始管理员（仅首次启动创建）
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_USERNAME=admin
# 留空则随机生成密码，并在启动日志中打印一次。
BOOTSTRAP_ADMIN_PASSWORD=
