# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=base-admin
# development | test | production
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
APP_DEBUG=true

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
HTTP_ADDR=:8080
HTTP_REQUEST_TIMEOUT=30s
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_MAX_BODY_BYTES=4194304
# Comma separated list. Empty means "trust no proxy", which makes the audit log
# record the real socket address. Set it to your load balancer CIDRs in production.
HTTP_TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=debug
# text | json
LOG_FORMAT=text
LOG_ADD_SOURCE=false

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=base_admin
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Shanghai

# Every table the application creates and queries is prefixed with this value,
# so several deployments can share one schema. Must match ^[a-z][a-z0-9_]*$ or
# be empty. Changing it after data exists requires a manual table rename.
DB_TABLE_PREFIX=base_

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_SLOW_QUERY_THRESHOLD=200ms
# silent | error | warn | info
DB_LOG_LEVEL=warn
# Apply the embedded SQL migrations during start-up.
DB_MIGRATE=true

# ---------------------------------------------------------------------------
# Redis (sessions and login throttling)
# ---------------------------------------------------------------------------
REDIS_ADDR=127.0.0.1:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
# Namespace for every key so several deployments can share one database.
REDIS_KEY_PREFIX=base-admin:
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_SIZE=20

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Required, at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=base-admin
JWT_AUDIENCE=base-admin-web
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=168h

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
SECURITY_BCRYPT_COST=10
SECURITY_PASSWORD_MIN_LENGTH=8
SECURITY_LOGIN_MAX_ATTEMPTS=5
SECURITY_LOGIN_WINDOW=15m
SECURITY_LOGIN_BLOCK_DURATION=15m
SECURITY_OPERATION_LOG_ENABLED=true
SECURITY_OPERATION_LOG_BODY_LIMIT=2048

# ---------------------------------------------------------------------------
# CORS (only needed when the frontend is served from another origin)
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Request-ID,X-Requested-With
CORS_EXPOSE_HEADERS=X-Request-ID
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=12h

# ---------------------------------------------------------------------------
# First administrator, created on start-up when missing
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_USERNAME=admin
# Leave empty to generate a random password; it is logged once.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NICKNAME=超级管理员
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
